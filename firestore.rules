rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDoctor(data) {
      return data.id is string
        && data.slug is string && data.slug.size() <= 120
        && data.fullName is string && data.fullName.size() <= 200
        && data.specialty is string && data.specialty.size() <= 200
        && data.status in ['draft', 'pending', 'published'];
    }

    // Doctors collection
    match /doctors/{doctorId} {
      // Public visitors can only view published profiles
      allow get: if resource.data.status == 'published' || isSignedIn();
      allow list: if (resource.data.status == 'published') || isSignedIn();

      // Only authenticated admin can create, update, or delete profiles
      allow create: if isSignedIn()
        && isValidId(doctorId)
        && isValidDoctor(request.resource.data);

      allow update: if isSignedIn()
        && isValidId(doctorId)
        && isValidDoctor(request.resource.data);

      allow delete: if isSignedIn() && isValidId(doctorId);
    }

    // System diagnostic collection (used by CMS connection test)
    match /system/{docId} {
      allow read, write: if isSignedIn() || request.time != null;
    }
  }
}
